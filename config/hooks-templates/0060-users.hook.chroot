#!/bin/bash
# Dua akun: spider untuk pemakaian harian, admin untuk administrasi.
set -e

# Admin: satu-satunya akun yang boleh sudo.
if ! id admin >/dev/null 2>&1; then
    useradd -m -s /bin/bash admin
fi

# Hak perangkat untuk admin.
for g in sudo audio video plugdev bluetooth dialout cdrom users; do
    if getent group "$g" >/dev/null 2>&1; then
        usermod -aG "$g" admin
    fi
done

echo 'admin:admin123' | chpasswd
chage -E -1 -M -1 admin 2>/dev/null || true
cp -a /etc/skel/. /home/admin/ 2>/dev/null || true
chown -R admin:admin /home/admin
chmod 700 /home/admin

# Spider: live-config gagal membuatnya karena UID 1000 dipakai admin,
# jadi dibuat di sini saat build.
if ! id spider >/dev/null 2>&1; then
    useradd -m -s /bin/bash spider
    echo 'spider:live' | chpasswd
    for g in audio video plugdev bluetooth users; do
        if getent group "$g" >/dev/null 2>&1; then
            usermod -aG "$g" spider
        fi
    done
    cp -a /etc/skel/. /home/spider/ 2>/dev/null || true
    chown -R spider:spider /home/spider
    chmod 700 /home/spider
fi

# Larangan sudo untuk spider; menimpa aturan NOPASSWD dari live-config.
cat > /etc/sudoers.d/99-spideros-no-sudo <<'EOF'
spider ALL=(ALL:ALL) !ALL
EOF
chmod 0440 /etc/sudoers.d/99-spideros-no-sudo

passwd -l root >/dev/null 2>&1 || true

echo "OK: admin dan spider siap."
